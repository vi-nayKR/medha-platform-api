# medha-api environment variable reference. Values are intentionally blank.
# Copy to .env for local development and obtain secrets from the authorized owner.

# Required runtime identity and core services
ENVIRONMENT=
SERVER_PORT=
LOG_LEVEL=
DATABASE_URL=
# Required only by the local Docker Compose PostgreSQL container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
REDIS_URL=
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SHARE_BASE_URL=

# Required authentication and administration
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_EXPIRY_MINUTES=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
CREDENTIALS_ENCRYPTION_KEY=

# Development-only test accounts; never configure in production
DEV_PANDIT_PHONE=
DEV_YAJMAN_PHONE=

# Optional external integrations
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_KEY_BASE64=
MESSAGECENTRAL_EMAIL=
MESSAGECENTRAL_BASE_URL=
MAPMYINDIA_CLIENT_ID=
MAPMYINDIA_CLIENT_SECRET=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_BASE64=
APNS_BUNDLE_ID=
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
ADMIN_EMAILS=
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Feature and public metadata settings
SWAGGER_ENABLED=
RISK_CHECK_ENABLED=
NEARBY_EVENT_RADIUS_KM=
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINT=
IOS_APP_ID_PREFIX=
IOS_BUNDLE_ID=
